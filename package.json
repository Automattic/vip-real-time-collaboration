{
  "name": "vip-real-time-collaboration",
  "version": "0.5.6",
  "description": "Real-time collaboration plugin for WordPress VIP",
  "main": "build/index.js",
  "keywords": [
    "wordpress",
    "plugin",
    "real-time",
    "collaboration",
    "vip"
  ],
  "files": [
    "build/",
    "inc/",
    "vendor/",
    "vip-real-time-collaboration.php"
  ],
  "author": "Automattic",
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "npm run cmd:build",
    "check-types": "tsc --noEmit",
    "cmd:build": "WP_DEVTOOL=source-map wp-scripts build --experimental-modules",
    "cmd:format": "prettier '**/*.(js|json|jsx|md|ts|tsx|yml|yaml)'",
    "cmd:lint:js": "eslint --quiet .",
    "dev": "./bin/start",
    "dev:destroy": "./bin/stop destroy",
    "dev:stop": "./bin/stop",
    "dev:websocket-server": "cd websocket-server && npm run dev",
    "dev:yjs-inspector": "cd yjs-inspector && npm run dev",
    "format": "npm run cmd:format -- --write",
    "format:check": "npm run cmd:format -- --check",
    "lint": "npm run format:check && npm run lint:js && npm run lint:css && npm run lint:php",
    "lint:css": "echo 'No CSS files have been committed yet.' # wp-scripts lint-style",
    "lint:css:fix": "wp-scripts lint-style --fix",
    "lint:js": "npm run cmd:lint:js && npm run check-types",
    "lint:js:fix": "npm run cmd:lint:js -- --fix",
    "lint:php": "npm run lint:phpcs && npm run lint:psalm",
    "lint:phpcs": "vendor/bin/phpcs --cache",
    "lint:phpcs:fix": "vendor/bin/phpcbf",
    "lint:psalm": "vendor/bin/psalm.phar",
    "packages-update": "wp-scripts packages-update",
    "plugin-zip": "npm run build && composer install --prefer-dist --optimize-autoloader --no-dev && wp-scripts plugin-zip --no-root-folder",
    "postinstall": "composer install",
    "release": "./bin/release",
    "start": "wp-scripts start --experimental-modules --stats=minimal",
    "test": "npm run test:js:unit && npm run test:integration",
    "test:e2e": "wp-scripts test-playwright --config tests/e2e/playwright.config.ts",
    "test:e2e:debug": "wp-scripts test-playwright --config tests/e2e/playwright.config.ts --ui",
    "test:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/vip-real-time-collaboration ./vendor/bin/phpunit -c phpunit-integration.xml",
    "test:js:unit": "npx tsx --experimental-test-module-mocks --test src/**/*.test.ts",
    "wp-cli": "wp-env run cli -- wp"
  },
  "devDependencies": {
    "@automattic/eslint-plugin-wpvip": "2.0.1",
    "@playwright/test": "^1.64.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@wordpress/api-fetch": "8.0.0",
    "@wordpress/blocks": "17.0.0",
    "@wordpress/components": "43.0.0",
    "@wordpress/compose": "9.0.0",
    "@wordpress/data": "11.0.0",
    "@wordpress/e2e-test-utils-playwright": "3.2.0",
    "@wordpress/element": "10.0.0",
    "@wordpress/env": "12.1.0",
    "@wordpress/hooks": "5.0.0",
    "@wordpress/i18n": "7.0.0",
    "@wordpress/plugins": "8.0.0",
    "@wordpress/private-apis": "3.0.0",
    "@wordpress/scripts": "37.1.0",
    "@wordpress/sync": "3.0.0",
    "eslint": "10.14.0",
    "fork-ts-checker-webpack-plugin": "9.1.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "npm:wp-prettier@3.0.3",
    "ts-loader": "9.6.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "ws": "8.22.1",
    "yjs": "13.6.32"
  },
  "dependencies": {
    "lib0": "0.2.114",
    "y-protocols": "1.0.7",
    "y-websocket": "3.1.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
